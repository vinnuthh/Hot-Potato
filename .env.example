# Optional. Frontend uses same-origin /api and /ws by default (Vite proxies to the local server).
VITE_API_URL=
VITE_WS_URL=

# Server configuration
PORT=3001
# Comma-separated fuse bounds in seconds (default 5,30)
FUSE_MIN_SECONDS=5
FUSE_MAX_SECONDS=30
# Milliseconds after disconnect before a player is removed / host is transferred
DISCONNECT_GRACE_MS=15000
# Hours before inactive rooms are cleaned up
ROOM_TTL_HOURS=12
